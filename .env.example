# Copy to .env  (or just run `python manage.py init`, which generates real values for you).
# NEVER commit .env. Keep a backup of MASTER_KEY in a password manager: if it is lost,
# every encrypted field and upload is permanently unreadable.
BIOQUEST_ENV=development        # set to "production" when deployed behind HTTPS
SECRET_KEY=change-me            # signs the session cookie
MASTER_KEY=change-me            # 32 random bytes, urlsafe-base64; derives all encryption keys
# TRUSTED_PROXIES=1             # number of reverse proxies in front (nginx, Caddy, a PaaS...)
# BIOQUEST_DATA_DIR=/var/lib/bioquest
