# Copy to .env by running:  npm run setup   (it generates all the random secrets for you)
# Never commit the real .env. Back it up securely: without these keys, encrypted data is unrecoverable.
NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://bioquest.example.org     # exact public https origin (used for CSRF checks)
TRUST_PROXY=1                                  # number of reverse proxies in front of the app

MIGRATE_DATABASE_URL=postgres://owner:CHANGE_ME@db:5432/bioquest   # owner role, used only by migrate/admin scripts
DATABASE_URL=postgres://bioquest_app:CHANGE_ME@db:5432/bioquest      # least-privilege app role (Row-Level Security applies)
WORKER_DATABASE_URL=postgres://bioquest_worker:CHANGE_ME@db:5432/bioquest
APP_DB_PASSWORD=CHANGE_ME
WORKER_DB_PASSWORD=CHANGE_ME
DATABASE_SSL=false                             # set true for managed Postgres over the network

MEDIA_KEK_1=64_hex_chars                       # wraps per-file keys
FIELD_ENCRYPTION_KEY=64_hex_chars              # emails, notes, GPS, 2FA secrets
HMAC_KEY=64_hex_chars                          # blind index, audit chain
PASSWORD_PEPPER=64_hex_chars                   # mixed into every password hash

UPLOAD_DIR=/data/vault
MODEL_DIR=/data/models
